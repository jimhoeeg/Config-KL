/**
 * Generates supabase/seed.sql from the TypeScript seed content and config defaults.
 * Run: npm run seed:generate
 */
import { writeFileSync } from "node:fs";
import { faqItems, knowledgeCards } from "../lib/content/knowledgeCards.ts";
import { defaultConfig } from "../lib/config/defaults.ts";

const q = (s: string) => `'${s.replace(/'/g, "''")}'`;
const lines: string[] = ["-- Generated by scripts/generate-seed.mts – do not edit by hand.", ""];

lines.push("insert into knowledge_cards (slug, step, title, body_md, illustration, sort_order) values");
lines.push(
  knowledgeCards
    .map((c) => `  (${q(c.slug)}, ${c.step}, ${q(c.title)}, ${q(c.body_md)}, ${q(c.illustration)}, ${c.sort_order})`)
    .join(",\n") +
    "\non conflict (slug) do update set step = excluded.step, title = excluded.title, body_md = excluded.body_md, illustration = excluded.illustration, sort_order = excluded.sort_order;",
);
lines.push("");

lines.push("delete from faq;");
lines.push("insert into faq (question, answer_md, sort_order) values");
lines.push(faqItems.map((f) => `  (${q(f.question)}, ${q(f.answer_md)}, ${f.sort_order})`).join(",\n") + ";");
lines.push("");

lines.push("-- Config rows start as a copy of the defaults; edit them in /admin/config.");
lines.push("insert into config (key, value) values");
lines.push(
  Object.entries(defaultConfig)
    .map(([key, value]) => `  (${q(key)}, ${q(JSON.stringify(value))}::jsonb)`)
    .join(",\n") + "\non conflict (key) do nothing;",
);
lines.push("");

writeFileSync(new URL("../supabase/seed.sql", import.meta.url), lines.join("\n"));
console.log(`Wrote supabase/seed.sql (${knowledgeCards.length} cards, ${faqItems.length} FAQ items)`);
