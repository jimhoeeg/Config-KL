# Public URL of this app (used in emails and the embed script)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase – server only. The service role key must NEVER be exposed to the browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM="KL Køleteknik <rapport@klkoleteknik.dk>"
# Comma-separated list of internal recipients for lead notifications
EMAIL_INTERNAL_TO=lars@klkoleteknik.dk

# Admin (/admin) – one shared password, cookie signed with the secret (min. 32 chars)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Address autocomplete (DAWA-compatible API). DAWA is being phased out – point this
# at the replacement endpoint when Klimadatastyrelsen switches it off.
ADDRESS_API_URL=https://api.dataforsyningen.dk
# Optional: Datafordeler API key for BBR prefill (floor area, year built, heating).
# Leave empty to disable BBR lookup – users then type the values themselves.
DATAFORDELER_API_KEY=

# Sites allowed to embed the module in an iframe (space-separated)
EMBED_ALLOWED_ORIGINS="https://klkoleteknik.dk https://www.klkoleteknik.dk"

# Tracking – only loaded after the visitor accepts cookies
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
BBR_API_URL=https://graphql.datafordeler.dk/BBR/v1
